{
  "manifest_version": 3,
  "name": "AI Chat Sidebar",
  "version": "1.0.0",
  "description": "Chat avec des LLM (API compatibles OpenAI, Anthropic), outils MCP et RAG local, dans la barre latérale de Firefox.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-chat-sidebar@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personalCommunications", "authenticationInfo"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "unlimitedStorage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "AI Chat",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "AI Chat",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Ouvrir / fermer la barre latérale AI Chat"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
